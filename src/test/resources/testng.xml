<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--<suite name="Selenium Maven Suite" verbose="1" parallel="false"> -->
<!-- For asynchronous test execution, set thread-count=1 if headless=true, 2 if false -->
<suite name="Regression Test" verbose="1" parallel="methods" thread-count="1">
    <listeners>
        <listener class-name="com.sel.listeners.TestListener"/>
    </listeners>
    <test name="Chrome UI Tests">
        <classes>
            <class name="com.sel.tests.HomePageTest"/>
            <class name="com.sel.tests.RestFundamentalsTest"/>
            <class name="com.sel.tests.SupportUsTest"/>
        </classes>
    </test>
</suite>
